<!DOCTYPE html>
<html>
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
  </head>
  <body style="margin:0; padding:32px 16px; background:#f7f5fb; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:480px; margin:0 auto;">
      <tr>
        <td style="padding-bottom:24px; text-align:center;">
          <span style="font-size:20px; font-weight:800; color:#4a2a8f; letter-spacing:-0.02em;">Fitora</span>
        </td>
      </tr>
      <tr>
        <td style="background:#ffffff; border:1px solid #e8e3f2; border-radius:16px; padding:32px;">
          <%= yield %>
        </td>
      </tr>
      <tr>
        <td style="padding-top:20px; text-align:center; font-size:12px; color:#948aae;">
          Fitora — cet e-mail vous a été envoyé car cette adresse est associée à un compte Fitora.
        </td>
      </tr>
    </table>
  </body>
</html>
