# Fitora backend — environment template.
# Copy to `.env` for local development (loaded by dotenv-rails in dev/test).
# In production these are set on the host / in the Kamal deploy config, not a file.

# ── Web / runtime ────────────────────────────────────────────────────────
PORT=3000
RAILS_MAX_THREADS=5
WEB_CONCURRENCY=1
# RAILS_LOG_LEVEL=info            # production only

# ── Datastores ──────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/1
# Local dev uses the postgres domain socket + default role (see config/database.yml).
# Production reads DB_HOST / DB_NAME / DB_USER / BACKEND_DATABASE_PASSWORD,
# or a full DATABASE_URL.
# BACKEND_DATABASE_PASSWORD=

# ── CORS / WebSocket origins (comma-separated) ──────────────────────────
FRONTEND_ORIGINS=http://localhost:4200,http://localhost:8081

# ── Credentials decryption (production alternative to config/master.key) ─
# RAILS_MASTER_KEY=

# ── SMS (Tunisie SMS) — required for booking reminders / OTP ────────────
TUNISIESMS_API_KEY=
TUNISIESMS_SENDER=Fitora

# ── Fitora's own bank account (shown to gym admins under "How to pay") ───
# Leave FITORA_RIB empty and the subscription page shows the generic
# "settle with Fitora" wording instead of bank details. Admins only —
# it is never sent to staff or members.
FITORA_RIB=
FITORA_BANK_NAME=
FITORA_ACCOUNT_HOLDER=
FITORA_SWIFT=

# ── Links and outgoing mail ─────────────────────────────────────────────
# APP_HOST and SMTP_* are REQUIRED in production — the server refuses to
# boot without them (config/initializers/required_env.rb). In development,
# mail is not sent and links point at FRONTEND_URL.
# APP_HOST=app.fitora.io
# FRONTEND_URL=http://localhost:4200
# MAIL_FROM="Fitora <no-reply@fitora.io>"
# SMTP_ADDRESS=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=

# ── Monitoring ──────────────────────────────────────────────────────────
# SENTRY_DSN=
# SIDEKIQ_WEB_PASSWORD=          # mounts /sidekiq behind HTTP basic auth
